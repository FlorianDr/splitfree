# Copy to apps/web/.env for local dev (or export in your shell). All validated at boot in
# apps/web/app/lib/env.server.ts.

# 32+ byte secret for signing session JWTs (HS256). Generate: openssl rand -base64 48
JWT_SECRET=

# Outgoing email over SMTP (login codes, invites, alerts). Any provider works; Resend for example:
#   SMTP_HOST=smtp.resend.com  SMTP_USER=resend  SMTP_PASSWORD=<your Resend API key>
# SMTP_SECURITY defaults to tls on ports 465/2465 and starttls otherwise; `none` (plaintext) is for
# a local mail catcher such as Mailpit (SMTP_HOST=localhost SMTP_PORT=1025) and refused in production.
# Leave SMTP_HOST unset in dev/test and emails (with the login code) are logged to the server console.
SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURITY=tls
SMTP_USER=
SMTP_PASSWORD=
OTP_FROM_EMAIL="splitfree <login@splitfree.cash>"

# Cloudflare Turnstile bot check on email sign-in. Optional: leave both unset to turn it off.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# WebAuthn / passkeys. RP_ID is the bare registrable domain; ORIGIN is the full https URL.
# For local dev over http://localhost, use RP_ID=localhost and ORIGIN=http://localhost:3000.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=splitfree
WEBAUTHN_ORIGIN=http://localhost:3000

# SQLite database file. In Docker this points at the mounted volume (/data/splitfree.db).
DATABASE_PATH=./splitfree.db

# Test-only: gates the Playwright auth-mock login route. NEVER set this in production.
# ALLOW_TEST_LOGIN=1
